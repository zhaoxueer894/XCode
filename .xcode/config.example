# XCode configuration (key=value, one per line). Copy this file to .xcode/config
# and fill in your keys. .xcode/config is gitignored and never enters git.
# Priority: CLI flags > project .xcode/config > global ~/.xcode/config > env > defaults.

# ---- Developer model (fill one provider) ----
provider=deepseek
deepseek-api-key=sk-...
# deepseek-base-url=https://api.deepseek.com
# deepseek-model=deepseek-flash

# provider=bailian
# bailian-api-key=sk-...
# bailian-model=qwen-plus

# provider=glm
# glm-api-key=...
# glm-model=glm-4.6

# ---- Cross-model reviewer (optional) ----
# Independent reviewer for the completion gate (blind spots differ from the
# developer model). Unset or failing reviewers fall back to the developer
# model with a warning; never silent.
# reviewer-provider=glm
# reviewer-model=glm-4.6

# ---- Orchestration (optional) ----
# empty = full-tool agent; single | single-review | pipeline (see README)
# orchestrate=

# ---- Compression classifier (optional; active only with --typed-shadow) ----
# jev=on  : TypeSafe systemone service (needs the typesafe-* keys).
# jev=off : a chat model. Defaults to the developer model; set BOTH
#           typed-classifier-* keys to use a dedicated model instead
#           (credential: bailian-api-key).
# jev=off
# typed-classifier-endpoint=https://dashscope.aliyuncs.com/compatible-mode/v1
# typed-classifier-model=qwen-plus
# typesafe-api-key=...
# typesafe-endpoint=...
# typesafe-model=...

# ---- Runtime (optional) ----
# mode=workspace-write
# context-strategy=bounded
# context-budget=6000
# max-steps=8
# timeout=2m
