# XCode configuration (key=value, one per line). Copy this file to .xcode/config
# and fill in your keys. .xcode/config is gitignored and never enters git.
# Priority: CLI flags > project .xcode/config > global ~/.xcode/config > env > defaults.

# ---- Active models (pick slot names from the model set below) ----
developer=deepseek
reviewer=glm

# ---- Model set: define as many slots as you need ----
model.deepseek.key=sk-...
model.deepseek.base-url=https://api.deepseek.com
model.deepseek.id=deepseek-flash

model.glm.key=...
model.glm.base-url=https://open.bigmodel.cn/api/paas/v4
model.glm.id=glm-4.6

# model.bailian.key=sk-...
# model.bailian.base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
# model.bailian.id=qwen-plus

# Any OpenAI-compatible endpoint works as its own slot:
# model.myagent.key=...
# model.myagent.base-url=https://api.example.com/v1
# model.myagent.id=some-model

# ---- Orchestration (optional) ----
# empty = full-tool agent; single | single-review | pipeline (see README)
# orchestrate=

# ---- Compression classifier (optional; only with --typed-shadow) ----
# jev=on  : TypeSafe systemone service (needs the typesafe-* keys below)
# jev=off : the developer model classifies. Default off.
# jev=off
# typesafe-api-key=...
# typesafe-endpoint=...
# typesafe-model=...

# ---- Runtime (optional) ----
# mode=workspace-write
# context-strategy=bounded
# context-budget=6000
# max-steps=8
# timeout=2m
